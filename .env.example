# Copy to .env (scripts/setup.sh does this). Every line is optional.

# Agents network. Must match the network created by scripts/setup.sh.
# AGENTGW_NETWORK=agentgw-agents
# AGENTGW_BRIDGE=br-agents
# AGENTGW_SUBNET4=172.30.0.0/24
# AGENTGW_GW4=172.30.0.1
# IPv6 (only if the agents network was created with --ipv6):
# AGENTGW_SUBNET6=fd00:a6e:1::/64
# AGENTGW_GW6=fd00:a6e:1::1

# Upstream resolvers for the gateway resolver. Default: the host's /etc/resolv.conf.
# AGENTGW_UPSTREAM_DNS=1.1.1.1,9.9.9.9

# Dashboard. Keep it on loopback and reach it with `ssh -L 8080:127.0.0.1:8080 vps`,
# or bind it to a Tailscale/WireGuard address (and list that hostname below).
# AGENTGW_ADMIN_LISTEN=127.0.0.1:8080
# AGENTGW_ADMIN_HOSTS=vps.tailnet-name.ts.net,100.101.102.103
# Recommended whenever the dashboard is reachable by anything but you:
# AGENTGW_ADMIN_TOKEN=

# Port of the agent API on the bridge IP.
# AGENTGW_AGENT_API_PORT=8081

# abuse.ch feeds (Feodo, URLhaus, ThreatFox) require a free Auth-Key: https://auth.abuse.ch/
# ABUSECH_AUTH_KEY=

# Group owning /var/run/docker.sock (setup.sh fills this in).
# DOCKER_GID=999
