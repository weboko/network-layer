#!/usr/sbin/nft -f
# Fail-closed placeholder for the agents bridge, loaded at boot before Docker
# starts, so agent containers that come up before the gateway have no new
# outbound connections. Matches only the agents bridge; nothing else on the
# host is affected. The gateway atomically replaces this table on start.
# Keep the bridge name in sync with AGENTGW_BRIDGE.

table inet agentgw
delete table inet agentgw

table inet agentgw {
  chain forward {
    type filter hook forward priority filter - 5; policy accept;
    iifname "br-agents" oifname != "br-agents" ct state != { established, related } reject with icmpx admin-prohibited
  }
  chain input {
    type filter hook input priority filter - 5; policy accept;
    iifname "br-agents" ct state != { established, related } reject with icmpx admin-prohibited
  }
}
